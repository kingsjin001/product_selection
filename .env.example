APP_ENV=development
APP_NAME=tiktok-selection-agent

# Host execution defaults. Docker Compose overrides these with container hostnames.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/tiktok_selection
REDIS_URL=redis://localhost:6379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530

# mock 让导入、索引、检索流程可在无模型密钥时复现；openai_compatible 用于真实模型服务。
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_DIM=16
# 可从本文件或系统环境变量读取；系统环境变量优先。
MODEL_API_KEY=
MODEL_BASE_URL=
CHAT_MODEL=

# Per-run guardrails used by the real Deep Agent demo.
MAX_MODEL_CALLS=20
MAX_TOOL_CALLS=30
AGENT_TIMEOUT_SECONDS=300

