APP_ENV=development
APP_NAME=tiktok-selection-agent
# INFO 仅输出关键步骤；改为 DEBUG 可查看检索命中和样例数据摘要。
LOG_LEVEL=INFO

# Host execution defaults. Docker Compose overrides these with container hostnames.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/tiktok_selection
REDIS_URL=redis://localhost:6379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530

# mock 让导入、索引、检索流程可在无模型密钥时复现；openai_compatible 用于真实模型服务。
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_DIM=16
# 仅在模型服务支持 dimensions 参数时填写；空值表示不传该参数。
EMBEDDING_REQUEST_DIMENSIONS=
# 单次请求最多发送的文本段数；默认 10 可兼容常见向量服务限制。
EMBEDDING_BATCH_SIZE=10
# 可从本文件或系统环境变量读取；系统环境变量优先。
# 若密钥已保存为其他系统变量，可使用 ${已有变量名} 映射，例如：
# MODEL_API_KEY=${LOCAL_MODEL_API_KEY}
MODEL_API_KEY=
MODEL_BASE_URL=
CHAT_MODEL=

# Per-run guardrails used by the real Deep Agent demo.
MAX_MODEL_CALLS=20
MAX_TOOL_CALLS=30
AGENT_TIMEOUT_SECONDS=300


# 第七期可选 MCP：默认 local；mcp 模式需要另起 app.mcp.server。
EVIDENCE_TRANSPORT=local
MCP_URL=http://127.0.0.1:8765/mcp
MCP_PORT=8765
# 至少 32 字符；可引用系统变量，例如 MCP_SHARED_SECRET="${RESEARCH_MCP_SECRET}"。
MCP_SHARED_SECRET=
MILVUS_DATABASE=default
